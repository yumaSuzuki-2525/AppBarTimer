<UserControl x:Class="AppBarTimer.Components.TimerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="60">

    <!-- 全体をクリッカブルにするための透明な背景を持つコンテナ -->
    <!-- ※カーソルを指マーク(Hand)にして、クリックイベント(MouseLeftButtonUp)を設定 -->
    <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonUp="TimerArea_Click">

        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">

            <!-- ① 上部の時間表示ボックス -->
            <Border Background="#E6E6E6" CornerRadius="8" Width="48" Padding="0,5,0,5">
                <StackPanel>
                    <TextBlock x:Name="MinText" Text="00" FontSize="20" FontWeight="Black" Foreground="Black" HorizontalAlignment="Center" FontFamily="Arial"/>
                    <TextBlock Text="m" FontSize="12" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Right" Margin="0,-5,8,0" FontFamily="Arial"/>
                    <TextBlock x:Name="SecText" Text="00" FontSize="20" FontWeight="Black" Foreground="Black" HorizontalAlignment="Center" FontFamily="Arial"/>
                    <TextBlock Text="s" FontSize="12" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Right" Margin="0,-5,8,0" FontFamily="Arial"/>
                </StackPanel>
            </Border>
            
            <!-- ② 下部のゲージボックス -->
            <Border Background="#E6E6E6" CornerRadius="8" Width="48" Padding="4" Margin="0,10,0,0">
                <StackPanel x:Name="GaugePanel">
                    <!-- ブロック（プログラム側で数を増減させますが、まずは見た目の配置） -->
                    <Rectangle Height="8" Fill="Black" Margin="0,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Height="8" Fill="Black" Margin="0,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Height="8" Fill="Black" Margin="0,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Height="8" Fill="Black" Margin="0,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Height="8" Fill="Black" Margin="0,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Height="8" Fill="Black" Margin="0,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Height="8" Fill="Black" Margin="0,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Height="8" Fill="Black" Margin="0,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Height="8" Fill="Black" Margin="0,2" RadiusX="2" RadiusY="2"/>
                    <Rectangle Height="8" Fill="Black" Margin="0,2" RadiusX="2" RadiusY="2"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>