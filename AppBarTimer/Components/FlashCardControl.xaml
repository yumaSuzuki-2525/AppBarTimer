<UserControl x:Class="AppBarTimer.Components.FlashCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand" 
             MouseLeftButtonUp="Card_Click"
             MouseMove="UserControl_MouseMove" MouseLeave="UserControl_MouseLeave"
             MouseWheel="UserControl_MouseWheel">

    <!-- 中身の増殖に合わせて無限に広がる土台 -->
    <Grid x:Name="RootContainer" Margin="10">

        <!-- 追加された枚数分だけ「┘」を描画するレイヤー（超軽量） -->
        <Path x:Name="StackEdges" Stroke="#D5CDBF" StrokeThickness="1"/>

        <!-- 現在のページの「┘」だけを赤く描画するレイヤー -->
        <Path x:Name="CurrentRedEdge" Stroke="#FF4444" StrokeThickness="2"/>

        <!-- メインのカード（一番左上に固定され、束は右下に増殖していく） -->
        <Border x:Name="CardBackground" Width="400" Height="260" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#F9F6F0" BorderBrush="#D5CDBF" BorderThickness="1" CornerRadius="8">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="HoverActionText" Grid.Row="0" Foreground="#B0A89F" FontSize="14" HorizontalAlignment="Right" IsHitTestVisible="False" FontWeight="Bold"/>

                <TextBlock x:Name="EnglishText" Grid.Row="1"
                           Text="Sample" FontSize="18" Foreground="#3A3532" FontWeight="Medium"
                           TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Top" LineHeight="28"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock x:Name="StatusText" Grid.Row="2" Text="🔊 Center to Read" FontSize="14" Foreground="#8C8279" VerticalAlignment="Center" Margin="0,15,0,10"/>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#E8E2D2" CornerRadius="6" Margin="0,0,10,5" Cursor="Hand" MouseLeftButtonUp="SearchTranslate_Click">
                            <TextBlock Text="🌐 翻訳" FontSize="14" Foreground="#554C45" Padding="12,8" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#E8E2D2" CornerRadius="6" Margin="0,0,10,5" Cursor="Hand" MouseLeftButtonUp="SearchImage_Click">
                            <TextBlock Text="🖼 画像" FontSize="14" Foreground="#554C45" Padding="12,8" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#E8D2D2" CornerRadius="6" Margin="0,0,0,5" Cursor="Hand" MouseLeftButtonUp="LogicalDelete_Click">
                            <TextBlock Text="🗑 隠す" FontSize="14" Foreground="#884444" Padding="12,8" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>

                    <Border Grid.Column="1" Background="#D2AAAA" CornerRadius="6" Margin="10,0,0,5" Cursor="Hand" MouseLeftButtonUp="PhysicalDelete_Click" VerticalAlignment="Bottom">
                        <TextBlock Text="💥 完全削除" FontSize="14" Foreground="#662222" Padding="12,8" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>