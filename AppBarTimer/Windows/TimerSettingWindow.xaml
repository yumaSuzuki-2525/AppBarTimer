<Window x:Class="AppBarTimer.Windows.TimerSettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="時間設定" Height="200" Width="300"
        Background="#222222" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Topmost="True">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
            <!-- 分の入力 -->
            <!-- MaxLength="3" で最大999まで、IMEオフ、文字入力制限とフォーカス外れ時の処理を追加 -->
            <TextBox x:Name="MinBox" Width="60" FontSize="30" TextAlignment="Center" Text="0" 
                 Background="#333333" Foreground="White" BorderThickness="0"
                 MaxLength="3" InputMethod.IsInputMethodEnabled="False"
                 PreviewTextInput="TextBox_PreviewTextInput" LostFocus="TextBox_LostFocus"/>
            <TextBlock Text="分" FontSize="20" Foreground="White" Margin="10,10,20,0" FontWeight="Bold"/>

            <!-- 秒の入力 -->
            <!-- MaxLength="2" で最大99まで（裏側で60に丸めます） -->
            <TextBox x:Name="SecBox" Width="60" FontSize="30" TextAlignment="Center" Text="0" 
                 Background="#333333" Foreground="White" BorderThickness="0"
                 MaxLength="2" InputMethod.IsInputMethodEnabled="False"
                 PreviewTextInput="TextBox_PreviewTextInput" LostFocus="TextBox_LostFocus"/>
            <TextBlock Text="秒" FontSize="20" Foreground="White" Margin="10,10,0,0" FontWeight="Bold"/>

        </StackPanel>

        <!-- スタートボタンの代わりとなる「設定」ボタン -->
        <Button Content="設定する" Width="140" Height="40" FontSize="16" FontWeight="Bold" 
                Background="#DDF3E4" Foreground="Black" BorderThickness="0" Cursor="Hand" Click="SetButton_Click">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
    </StackPanel>
</Window>