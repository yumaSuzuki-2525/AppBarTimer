<UserControl x:Class="AppBarTimer.Components.FlashCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MouseWheel="UserControl_MouseWheel">
    <!-- スクロールはどこでも効くように残す -->

    <Grid x:Name="RootContainer" Margin="10" Background="Transparent" MouseLeftButtonUp="RootContainer_MouseLeftButtonUp">

        <!-- 透過しない「完全なカードの束」を表現する3つのレイヤー -->
        <!-- 奥の束 -->
        <Path x:Name="BackgroundStack" Fill="#F9F6F0" Stroke="#D5CDBF" StrokeThickness="1" Panel.ZIndex="0"/>
        <!-- 現在位置（赤枠） -->
        <Path x:Name="CurrentRedStack" Fill="#F9F6F0" Stroke="#FF4444" StrokeThickness="2" Panel.ZIndex="1"/>
        <!-- 手前の束 -->
        <Path x:Name="ForegroundStack" Fill="#F9F6F0" Stroke="#D5CDBF" StrokeThickness="1" Panel.ZIndex="2"/>

        <!-- メインのカード（一番手前） -->
        <!-- ★角丸を0にし、ホバーとクリック判定をこのBorderのみに限定 -->
        <Border x:Name="CardBackground" Width="420" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#F9F6F0" BorderBrush="#D5CDBF" BorderThickness="1" CornerRadius="0"
                Panel.ZIndex="3" Cursor="Hand"
                MouseLeftButtonUp="CardBackground_MouseLeftButtonUp"
                MouseMove="CardBackground_MouseMove" 
                MouseLeave="CardBackground_MouseLeave">

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ★ 日付表示用（左上）を追加 -->
                <TextBlock x:Name="DateText" Grid.Row="0" Foreground="#B0A89F" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <!-- ホバーガイド（右上） -->
                <TextBlock x:Name="HoverActionText" Grid.Row="0" Foreground="#B0A89F" FontSize="14" HorizontalAlignment="Right" IsHitTestVisible="False" FontWeight="Bold"/>

                <TextBlock x:Name="EnglishText" Grid.Row="1"
                           Text="Sample" FontSize="18" Foreground="#3A3532" FontWeight="Medium"
                           TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Top" LineHeight="28"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock x:Name="StatusText" Grid.Row="2" Text="🔊 Center to Read" FontSize="14" Foreground="#8C8279" VerticalAlignment="Center" Margin="0,15,0,10"/>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- ボタン類は少しだけ丸みを残して押しやすさを維持 -->
                        <Border Background="#E8E2D2" CornerRadius="4" Margin="0,0,10,5" Cursor="Hand" MouseLeftButtonUp="SearchTranslate_Click">
                            <TextBlock Text="🌐 翻訳" FontSize="14" Foreground="#554C45" Padding="12,8" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#E8E2D2" CornerRadius="4" Margin="0,0,10,5" Cursor="Hand" MouseLeftButtonUp="SearchImage_Click">
                            <TextBlock Text="🖼 画像" FontSize="14" Foreground="#554C45" Padding="12,8" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#E8D2D2" CornerRadius="4" Margin="0,0,0,5" Cursor="Hand" MouseLeftButtonUp="LogicalDelete_Click">
                            <TextBlock Text="🗑 隠す" FontSize="14" Foreground="#884444" Padding="12,8" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>

                    <Border Grid.Column="1" Background="#D2AAAA" CornerRadius="4" Margin="10,0,0,5" Cursor="Hand" MouseLeftButtonUp="PhysicalDelete_Click" VerticalAlignment="Bottom">
                        <TextBlock Text="💥 完全削除" FontSize="14" Foreground="#662222" Padding="12,8" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>