<Window x:Class="AppBarTimer.Windows.TimerFinishedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="終了" Height="300" Width="600"
        Background="#FF4444" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" Cursor="Hand">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="TIME IS UP!" FontSize="70" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="(クリックして閉じる)" FontSize="20" Foreground="White" HorizontalAlignment="Center" Margin="0,20,0,0" Opacity="0.8"/>
        </StackPanel>
    </Grid>
</Window>